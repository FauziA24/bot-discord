# Discord Bot Token
# Dapatkan dari: https://discord.com/developers/applications
DISCORD_TOKEN=your_discord_bot_token_here
COMMAND_PREFIX=!
SYNC_COMMANDS=false

# Safety and capacity limits
MAX_QUEUE_SIZE=100
MAX_QUERY_LENGTH=300
IDLE_DISCONNECT_SECONDS=30

# Spotify Credentials (optional - untuk fitur Spotify)
# Dapatkan dari: https://developer.spotify.com/dashboard
SPOTIPY_CLIENT_ID=
SPOTIPY_CLIENT_SECRET=
